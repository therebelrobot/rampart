{
  "name": "rampart",
  "version": "0.2.0",
  "description": "Self-hosted pixel-art palette generator: value-first, hue-shifted color ramps with Procreate export.",
  "license": "Unlicense",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc --noEmit -p tsconfig.json && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "test": "esbuild tests/*.test.ts --bundle --platform=node --format=esm --outdir=.test-build --out-extension:.js=.mjs && node --test .test-build/*.test.mjs",
    "docker:build": "docker buildx build --platform linux/amd64,linux/arm64 -t ghcr.io/therebelrobot/rampart:latest .",
    "docker:run": "docker run --rm -p 8080:8080 ghcr.io/therebelrobot/rampart:latest",
    "docker:push": "docker buildx build --platform linux/amd64,linux/arm64 -t ghcr.io/therebelrobot/rampart:latest --push .",
    "release:patch": "npm version patch -m 'release: %s' && git push --follow-tags",
    "release:minor": "npm version minor -m 'release: %s' && git push --follow-tags",
    "release:major": "npm version major -m 'release: %s' && git push --follow-tags",
    "release:tags": "git tag --list 'v*' --sort=-v:refname | head -n 10"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
